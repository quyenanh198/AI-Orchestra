{
  "name": "ai-orchestra",
  "displayName": "AI Orchestra",
  "description": "A supervisor agent that delegates each prompt to one subscription/free AI agent, based on fit and remaining limit, with shared conversation context",
  "version": "0.3.7",
  "publisher": "ai-orchestra",
  "repository": {
    "type": "git",
    "url": "https://github.com/quyenanh198/AI-Orchestra.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "AI Orchestra runs local CLIs and can let agents read, write and execute in the workspace, so it is disabled until you trust the folder."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "ai-orchestra.openChat",
        "title": "AI Orchestra: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ai-orchestra.configure",
        "title": "AI Orchestra: Login / Configure Providers"
      },
      {
        "command": "ai-orchestra.manageModelPermissions",
        "title": "AI Orchestra: Manage Model Permissions"
      },
      {
        "command": "ai-orchestra.installRecommendations",
        "title": "AI Orchestra: Install Recommended Extensions"
      },
      {
        "command": "ai-orchestra.manageBillingMode",
        "title": "AI Orchestra: Manage Billing Mode"
      },
      {
        "command": "ai-orchestra.showUsage",
        "title": "AI Orchestra: Show Usage Dashboard"
      },
      {
        "command": "ai-orchestra.switchModel",
        "title": "AI Orchestra: Switch Model"
      },
      {
        "command": "ai-orchestra.resetBudget",
        "title": "AI Orchestra: Reset Session Budget"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-orchestra",
          "title": "AI Orchestra",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-orchestra": [
        {
          "type": "webview",
          "id": "ai-orchestra.chatView",
          "name": "Chat"
        },
        {
          "id": "ai-orchestra.providers",
          "name": "Providers"
        },
        {
          "id": "ai-orchestra.usage",
          "name": "Budget Usage"
        }
      ]
    },
    "configuration": {
      "title": "AI Orchestra",
      "properties": {
        "ai-orchestra.budget.maxTokensPerSession": {
          "type": "number",
          "default": 100000,
          "description": "Maximum tokens allowed per session"
        },
        "ai-orchestra.budget.maxTokensPerDay": {
          "type": "number",
          "default": 500000,
          "minimum": 1000,
          "description": "Maximum tokens allowed per day (kept separate from the per-session limit)"
        },
        "ai-orchestra.budget.criticalThreshold": {
          "type": "number",
          "default": 0.95,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Fraction of the daily budget at which AI Orchestra downgrades to budget models"
        },
        "ai-orchestra.budget.maxCostPerDay": {
          "type": "number",
          "default": 5,
          "description": "Maximum cost per day in USD"
        },
        "ai-orchestra.budget.maxTokensPerTask": {
          "type": "number",
          "default": 32000,
          "minimum": 1000,
          "description": "Maximum tokens the executor agent may use for one prompt (all of its tool turns)"
        },
        "ai-orchestra.agents.maxToolTurns": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum model calls the executor agent may make for one prompt while using tools"
        },
        "ai-orchestra.limits": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "description": "Soft per-agent limits the supervisor uses to pick an agent, e.g. { \"claude-code\": { \"requests\": 40, \"windowHours\": 5 } }. Subscription CLIs do not report remaining quota, so this counts requests AI Orchestra made; an agent that reports a rate limit is also paused automatically. Agents without an entry are treated as unlimited.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "requests": { "type": "number", "minimum": 1 },
              "windowHours": { "type": "number", "minimum": 0.1 }
            }
          }
        },
        "ai-orchestra.context.maxTokens": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Upper bound on the shared context (earlier conversation digest, recent turns and workspace notes) sent to the executor agent; also capped at half of that agent's context window"
        },
        "ai-orchestra.context.recentTurns": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "maximum": 50,
          "description": "Number of recent conversation turns kept verbatim; older turns are folded into a one-line-each digest"
        },
        "ai-orchestra.budget.warningThreshold": {
          "type": "number",
          "default": 0.8,
          "description": "Warning threshold for budget (0-1)"
        },
        "ai-orchestra.billing.mode": {
          "type": "string",
          "enum": [
            "subscriptionOnly",
            "creditWithConfirmation"
          ],
          "default": "subscriptionOnly",
          "scope": "machine",
          "enumDescriptions": [
            "Use only subscription-backed, free, or local providers",
            "Allow credit providers but require confirmation before every request"
          ],
          "description": "Controls whether API-credit providers may be invoked"
        },
        "ai-orchestra.routing.preferredProvider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode-lm",
            "codex-cli",
            "claude-code",
            "antigravity-cli",
            "grok-cli",
            "openai",
            "anthropic",
            "gemini",
            "ollama"
          ],
          "default": "auto",
          "description": "Preferred AI provider"
        },
        "ai-orchestra.routing.fallbackOrder": {
          "type": "array",
          "default": [
            "vscode-lm",
            "codex-cli",
            "claude-code",
            "antigravity-cli",
            "grok-cli",
            "openai",
            "anthropic",
            "gemini",
            "ollama"
          ],
          "description": "Fallback order for AI providers"
        },
        "ai-orchestra.routing.autoDowngrade": {
          "type": "boolean",
          "default": true,
          "description": "Automatically downgrade to a cheaper model if budget is low"
        },
        "ai-orchestra.ollama.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "scope": "machine",
          "description": "Ollama API endpoint. Machine-scoped: a workspace cannot redirect your prompts to another host."
        },
        "ai-orchestra.tools.allowWorkspaceWrite": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow worker agents with the workspace.write capability to modify workspace files"
        },
        "ai-orchestra.tools.allowTerminal": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Allow worker agents with the terminal.execute capability to run allowlisted commands"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "ai-orchestra.openChat",
          "group": "ai-orchestra"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts",
    "test": "node --import tsx --test src/test/**/*.test.ts",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.0",
    "google-auth-library": "^10.9.1",
    "gpt-tokenizer": "^2.8.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
